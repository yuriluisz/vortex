generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// MULTI-TENANT CORE
// ============================================================================

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum UserRoleExpr {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  plan         Plan     @default(FREE)
  active       Boolean  @default(true)
  customDomain String?  @unique

  // Limites por plano
  maxCampaigns Int      @default(1)
  maxGroups    Int      @default(3)
  maxLeads     Int      @default(100)

  // Metadados
  logo         String?
  primaryColor String?  @default("#000000")

  // Relações
  users        User[]
  campaigns    Campaign[]
  groups       Group[]
  leads        Lead[]
  auditLogs    AuditLog[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([active])
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  passwordHash String
  avatarUrl    String?

  // Tenant direto (one-to-one simplificado)
  tenantId     String?
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         UserRoleExpr @default(ADMIN)

  // 2FA
  otpEnabled   Boolean      @default(false)
  otpSecret    String?

  // Relações
  auditLogs    AuditLog[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
  @@index([tenantId])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

enum AuditAction {
  LOGIN
  LOGOUT
  OTP_SENT
  OTP_VERIFIED
  TENANT_CREATED
  TENANT_SWITCHED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_DELETED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  LEAD_CREATED
  LEAD_EXPORTED
  USER_INVITED
  USER_REMOVED
  PLAN_CHANGED
  EMAIL_CHANGED
  TENANT_UPDATED
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String?
  userId    String?
  action    AuditAction
  details   Json?
  ip        String?

  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

// ============================================================================
// CAMPANHAS
// ============================================================================

model Campaign {
  id         String   @id @default(uuid())
  tenantId   String
  slug       String
  name       String
  rawHtml    String   @db.Text
  formSchema Json
  pixelId    String?
  active     Boolean  @default(true)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups     Group[]
  leads      Lead[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, active])
}

// ============================================================================
// GRUPOS DE WHATSAPP
// ============================================================================

model Group {
  id           String   @id @default(uuid())
  tenantId     String
  campaignId   String
  name         String
  url          String
  currentCount Int      @default(0)
  maxCapacity  Int      @default(150)
  active       Boolean  @default(true)

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([campaignId])
}

// ============================================================================
// LEADS
// ============================================================================

enum LeadStatus {
  PENDING
  JOINED
  NOT_JOINED
  EXPIRED
}

model Lead {
  id         String     @id @default(uuid())
  tenantId   String
  campaignId String
  name       String?
  whatsapp   String
  answers    Json?
  metadata   Json?
  datadb     String
  horadb     String

  // Status de validação de entrada
  status     LeadStatus @default(PENDING)
  joinedAt   DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt  DateTime   @default(now())

  @@index([tenantId])
  @@index([campaignId])
  @@index([tenantId, status])
  @@index([whatsapp, tenantId])
}