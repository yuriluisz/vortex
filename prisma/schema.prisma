generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// MULTI-TENANT CORE
// ============================================================================

enum Plan {
  FREE
  PRO
  ULTRA
}

enum UserRoleExpr {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  plan         Plan     @default(FREE)
  active       Boolean  @default(true)
  customDomain String?  @unique

  // Limites por plano
  maxCampaigns Int      @default(1)
  maxGroups    Int      @default(3)
  maxLeads     Int      @default(100)

  // Metadados
  logo         String?
  primaryColor String?  @default("#000000")

  // Dados Fiscais para Pagamento (ASAAS)
  billingCpfCnpj     String?
  billingPersonType  String?  // "FISICA" | "JURIDICA"
  billingBusinessName String?
  billingPhone       String?
  billingAddress     Json?    // { street, number, complement, neighborhood, city, state, zipCode }

  // Asaas Pay Integration
  asaasCustomerId    String?
  asaasSubscriptionId String?
  subscriptionStatus String   @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELED, CANCELING, PENDING_PAYMENT
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  pendingPlan        Plan?     // Plano aguardando confirmação de pagamento
  lastPaymentId      String?   // Último paymentId processado (idempotência do webhook)
  cancelAt           DateTime? // Data em que o downgrade/cancelamento será efetivado
  gracePeriodEnd     DateTime? // Data limite da carência (vencimento + 5 dias)
  downgradeReason    String?   // "INADIMPLENCIA" | "CANCELAMENTO_VOLUNTARIO" | null
  overLimit          Boolean   @default(false) // Se os dados excedem o limite atual

  // Relações
  users              User[]
  campaigns          Campaign[]
  groups             Group[]
  leads              Lead[]
  pageViews          PageView[]
  auditLogs          AuditLog[]
  evolutionInstance  EvolutionInstance?
  groupMessages      GroupMessage[]
  templates          Template[]
  templateUsages     TemplateUsage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([active])
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  passwordHash String
  avatarUrl    String?

  // Perfil público (comunidade)
  handle       String?      @unique // @unique permite null, mas só um null
  displayName  String?
  bio          String?      @db.Text
  profileLinks Json?        // { website, instagram, youtube, whatsapp }
  publicProfile Boolean     @default(false)

  // Tenant direto (one-to-one simplificado)
  tenantId     String?
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         UserRoleExpr @default(ADMIN)

  // 2FA
  otpEnabled   Boolean      @default(false)
  otpSecret    String?

  // Bloqueio administrativo (super admin)
  blocked      Boolean      @default(false)
  // Bloqueio específico de envio de templates
  templateBlocked Boolean   @default(false)

  // Relações
  auditLogs    AuditLog[]
  templates    Template[]   // Templates publicados pelo usuário
  templateLikes TemplateLike[]
  templateReports TemplateReport[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
  @@index([tenantId])
  @@index([handle])
}

// ============================================================================
// COMMUNITY & TEMPLATES
// ============================================================================

enum TemplateStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  TAKEN_DOWN
}

enum TemplateTheme {
  DARK
  LIGHT
  COLORFUL
}

enum TemplateCategory {
  LANDING_PAGE
  SQUEEZE_PAGE
  WEBINAR
  ECOMMERCE
  INFOPRODUCT
  PORTFOLIO
  EVENT
  OTHER
}

model Template {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?  @db.Text
  thumbnailUrl  String?

  // Metadados de categorização
  category      TemplateCategory @default(OTHER)
  theme         TemplateTheme    @default(LIGHT)
  primaryColor  String?          @default("#000000")
  typography    String?          // Nome da fonte principal
  productType   String?          // Tipo de produto/serviço
  tags          String[]         // Tags de busca

  // Status e moderação
  status        TemplateStatus @default(DRAFT)
  isFeatured    Boolean        @default(false)
  rejectionReason String?       @db.Text
  moderationNote  String?       @db.Text
  moderatedBy     String?
  moderatedAt     DateTime?

  // Contadores
  viewCount     Int  @default(0)
  useCount      Int  @default(0)
  likeCount     Int  @default(0)

  // Proveniência (apenas auditoria — snapshot 100% autônomo)
  sourceCampaignId String?
  authorId          String
  author            User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Versões do template
  versions         TemplateVersion[]

  // Relações
  tenantId          String?
  tenant            Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  usages            TemplateUsage[]
  likes             TemplateLike[]
  reports           TemplateReport[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, useCount])
  @@index([category, status])
  @@index([theme, status])
  @@index([authorId])
  @@index([tenantId])
}

model TemplateVersion {
  id            String   @id @default(uuid())
  templateId    String
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version       Int      @default(1)
  rawHtml       String   @db.Text
  formSchema    Json?

  // Status da versão (para moderação)
  status        TemplateStatus @default(DRAFT)
  rejectionReason String?       @db.Text
  moderationNote  String?       @db.Text

  publishedAt   DateTime?
  createdAt     DateTime @default(now())

  @@unique([templateId, version])
  @@index([templateId, status])
  @@index([templateId, version])
}

model TemplateUsage {
  id          String   @id @default(uuid())
  templateId  String
  tenantId    String
  campaignId  String

  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([templateId])
  @@index([tenantId])
  @@index([campaignId])
}

model TemplateLike {
  id          String   @id @default(uuid())
  templateId  String
  userId      String

  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([templateId, userId])
}

model TemplateReport {
  id          String   @id @default(uuid())
  templateId  String
  userId      String?
  reason      String   @db.Text
  status      String   @default("PENDING") // PENDING | RESOLVED | DISMISSED

  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([templateId])
  @@index([status])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

enum AuditAction {
  LOGIN
  LOGOUT
  OTP_SENT
  OTP_VERIFIED
  TENANT_CREATED
  TENANT_SWITCHED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_DELETED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  LEAD_CREATED
  LEAD_EXPORTED
  USER_INVITED
  USER_REMOVED
  PLAN_CHANGED
  EMAIL_CHANGED
  TENANT_UPDATED
  WHATSAPP_CONNECTED
  WHATSAPP_DISCONNECTED
  GROUP_MESSAGE_SENT
  GROUP_AUTO_CREATED
  GROUP_BULK_CREATED
  GROUP_SYNCED
  TEMPLATE_PUBLISHED
  TEMPLATE_APPROVED
  TEMPLATE_REJECTED
  TEMPLATE_CLONED
  TEMPLATE_REPORTED
  TEMPLATE_TAKEN_DOWN
  PROFILE_UPDATED
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String?
  userId    String?
  action    AuditAction
  details   Json?
  ip        String?

  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

// ============================================================================
// CAMPANHAS
// ============================================================================

model Campaign {
  id         String   @id @default(uuid())
  tenantId   String
  slug       String
  name       String
  rawHtml    String   @db.Text
  formSchema Json
  pixelId    String?
  gtmId      String?
  active     Boolean  @default(true)
  views      Int      @default(0)

  // Proteção de campanha
  protected    Boolean  @default(false)
  accessCode   String?  @unique

  // Domínio customizado exclusivo (ULTRA)
  customDomain String?  @unique

  // Rastreabilidade de template (opcional)
  templateOriginId String?

  // Configurações Padrão para Auto-Criação de Grupos
  groupMaxCapacity   Int      @default(1000)
  groupSupportPhones String[] // Array de telefones (ex: ["5511999999999"])
  groupDescription   String?  @db.Text
  groupImageUrl      String?

  // Identidade do Link (PRO/ULTRA) — branding do cliente no preview do link
  metaTitle       String?
  metaDescription String?  @db.Text
  ogImageUrl      String?
  faviconUrl      String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups        Group[]
  leads         Lead[]
  pageViews     PageView[]
  groupMessages GroupMessage[]
  templateUsages TemplateUsage[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([accessCode])
  @@index([customDomain])
}

// ============================================================================
// PAGE VIEWS
// ============================================================================

model PageView {
  id         String   @id @default(uuid())
  campaignId String
  tenantId   String
  createdAt  DateTime @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([tenantId, createdAt])
}

// ============================================================================
// GRUPOS DE WHATSAPP
// ============================================================================

model Group {
  id           String   @id @default(uuid())
  tenantId     String
  campaignId   String
  name         String
  url          String
  currentCount Int      @default(0)
  maxCapacity  Int      @default(150)
  active       Boolean  @default(true)

  // Evolution API
  groupJid     String?  // JID do grupo WhatsApp (ex: 123456789@g.us)
  inviteCode   String?  // Código do invite extraído da URL
  autoCreated  Boolean  @default(false) // Se foi criado automaticamente

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads        Lead[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([campaignId])
  @@index([groupJid])
}

// ============================================================================
// LEADS
// ============================================================================

enum LeadStatus {
  PENDING
  JOINED
  NOT_JOINED
  EXPIRED
}

model Lead {
  id         String     @id @default(uuid())
  tenantId   String
  campaignId String
  name       String?
  whatsapp   String
  answers    Json?
  metadata   Json?
  datadb     String
  horadb     String

  // Status de validação de entrada
  status     LeadStatus @default(PENDING)
  joinedAt   DateTime?

  // Grupo em que efetivamente entrou
  groupId    String?
  group      Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt  DateTime   @default(now())

  @@index([tenantId])
  @@index([campaignId])
  @@index([tenantId, status])
  @@index([whatsapp, tenantId])
  @@index([groupId])
}

// ============================================================================
// EVOLUTION API — WHATSAPP
// ============================================================================

model EvolutionInstance {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  instanceName String   // = slug do tenant
  phoneNumber  String   // Número inserido pelo usuário
  status       String   @default("DISCONNECTED") // DISCONNECTED | CONNECTING | CONNECTED

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([instanceName])
}

model GroupMessage {
  id         String   @id @default(uuid())
  tenantId   String
  campaignId String
  content    String   @db.Text
  targetType String   // "ALL" | "SELECTED"
  groupIds   String[] // IDs dos grupos alvo
  sentBy     String   // userId que enviou
  status     String   @default("PENDING") // PENDING | SENT | PARTIAL | FAILED
  sentAt     DateTime @default(now())
  results    Json?    // { groupId: "OK" | "FAILED" } por grupo

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([campaignId])
  @@index([tenantId, sentAt])
}