generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// MULTI-TENANT CORE
// ============================================================================

enum Plan {
  FREE
  PRO
  ULTRA
}

enum UserRoleExpr {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  plan         Plan     @default(FREE)
  active       Boolean  @default(true)
  customDomain String?  @unique

  // Limites por plano
  maxCampaigns Int      @default(1)
  maxGroups    Int      @default(3)
  maxLeads     Int      @default(100)

  // Metadados
  logo         String?
  primaryColor String?  @default("#000000")

  // Dados Fiscais para Pagamento (ASAAS)
  billingCpfCnpj     String?
  billingPersonType  String?  // "FISICA" | "JURIDICA"
  billingBusinessName String?
  billingPhone       String?
  billingAddress     Json?    // { street, number, complement, neighborhood, city, state, zipCode }

  // Asaas Pay Integration
  asaasCustomerId    String?
  asaasSubscriptionId String?
  subscriptionStatus String   @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELED, CANCELING, PENDING_PAYMENT
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  pendingPlan        Plan?     // Plano aguardando confirmação de pagamento
  lastPaymentId      String?   // Último paymentId processado (idempotência do webhook)
  cancelAt           DateTime? // Data em que o downgrade/cancelamento será efetivado
  gracePeriodEnd     DateTime? // Data limite da carência (vencimento + 5 dias)
  downgradeReason    String?   // "INADIMPLENCIA" | "CANCELAMENTO_VOLUNTARIO" | null
  overLimit          Boolean   @default(false) // Se os dados excedem o limite atual

  // Relações
  users              User[]
  campaigns          Campaign[]
  groups             Group[]
  leads              Lead[]
  pageViews          PageView[]
  auditLogs          AuditLog[]
  evolutionInstance  EvolutionInstance?
  groupMessages      GroupMessage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([active])
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  passwordHash String
  avatarUrl    String?

  // Tenant direto (one-to-one simplificado)
  tenantId     String?
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         UserRoleExpr @default(ADMIN)

  // 2FA
  otpEnabled   Boolean      @default(false)
  otpSecret    String?

  // Bloqueio administrativo (super admin)
  blocked      Boolean      @default(false)

  // Relações
  auditLogs    AuditLog[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
  @@index([tenantId])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

enum AuditAction {
  LOGIN
  LOGOUT
  OTP_SENT
  OTP_VERIFIED
  TENANT_CREATED
  TENANT_SWITCHED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_DELETED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  LEAD_CREATED
  LEAD_EXPORTED
  USER_INVITED
  USER_REMOVED
  PLAN_CHANGED
  EMAIL_CHANGED
  TENANT_UPDATED
  WHATSAPP_CONNECTED
  WHATSAPP_DISCONNECTED
  GROUP_MESSAGE_SENT
  GROUP_AUTO_CREATED
  GROUP_BULK_CREATED
  GROUP_SYNCED
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String?
  userId    String?
  action    AuditAction
  details   Json?
  ip        String?

  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

// ============================================================================
// CAMPANHAS
// ============================================================================

model Campaign {
  id         String   @id @default(uuid())
  tenantId   String
  slug       String
  name       String
  rawHtml    String   @db.Text
  formSchema Json
  pixelId    String?
  active     Boolean  @default(true)
  views      Int      @default(0)

  // Proteção de campanha
  protected  Boolean  @default(false)
  accessCode String?  @unique

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups        Group[]
  leads         Lead[]
  pageViews     PageView[]
  groupMessages GroupMessage[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([accessCode])
}

// ============================================================================
// PAGE VIEWS
// ============================================================================

model PageView {
  id         String   @id @default(uuid())
  campaignId String
  tenantId   String
  createdAt  DateTime @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([tenantId, createdAt])
}

// ============================================================================
// GRUPOS DE WHATSAPP
// ============================================================================

model Group {
  id           String   @id @default(uuid())
  tenantId     String
  campaignId   String
  name         String
  url          String
  currentCount Int      @default(0)
  maxCapacity  Int      @default(150)
  active       Boolean  @default(true)

  // Evolution API
  groupJid     String?  // JID do grupo WhatsApp (ex: 123456789@g.us)
  inviteCode   String?  // Código do invite extraído da URL
  autoCreated  Boolean  @default(false) // Se foi criado automaticamente

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads        Lead[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([campaignId])
  @@index([groupJid])
}

// ============================================================================
// LEADS
// ============================================================================

enum LeadStatus {
  PENDING
  JOINED
  NOT_JOINED
  EXPIRED
}

model Lead {
  id         String     @id @default(uuid())
  tenantId   String
  campaignId String
  name       String?
  whatsapp   String
  answers    Json?
  metadata   Json?
  datadb     String
  horadb     String

  // Status de validação de entrada
  status     LeadStatus @default(PENDING)
  joinedAt   DateTime?

  // Grupo em que efetivamente entrou
  groupId    String?
  group      Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt  DateTime   @default(now())

  @@index([tenantId])
  @@index([campaignId])
  @@index([tenantId, status])
  @@index([whatsapp, tenantId])
  @@index([groupId])
}

// ============================================================================
// EVOLUTION API — WHATSAPP
// ============================================================================

model EvolutionInstance {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  instanceName String   // = slug do tenant
  phoneNumber  String   // Número inserido pelo usuário
  status       String   @default("DISCONNECTED") // DISCONNECTED | CONNECTING | CONNECTED

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([instanceName])
}

model GroupMessage {
  id         String   @id @default(uuid())
  tenantId   String
  campaignId String
  content    String   @db.Text
  targetType String   // "ALL" | "SELECTED"
  groupIds   String[] // IDs dos grupos alvo
  sentBy     String   // userId que enviou
  status     String   @default("PENDING") // PENDING | SENT | PARTIAL | FAILED
  sentAt     DateTime @default(now())
  results    Json?    // { groupId: "OK" | "FAILED" } por grupo

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([campaignId])
  @@index([tenantId, sentAt])
}