# =========================================
# VÓRTEX+ — Variáveis de Ambiente
# =========================================
# Copie este arquivo para .env e preencha os valores.

# Ambiente
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://sua-url.com.br"

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/vortex_db?schema=public"

# Redis
REDIS_URL="redis://default:password@host:6379"

# Autenticação e Segurança
JWT_SECRET="chave-criptografica-ultra-segura-64-bytes"
ADMIN_EMAIL="seu-email-admin@dominio.com.br"
ADMIN_PASSWORD_HASH="hash-bcrypt-da-sua-senha"

# Serviços Externos
RESEND_API_KEY="re_123456789"
CLOUDFLARE_TURNSTILE_SECRET="0x4AAAAAA..."
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# Evolution API (WhatsApp) — Instância global
EVOLUTION_API_URL="https://evolution.seudominio.com"
EVOLUTION_API_KEY="sua-api-key-evolution"
